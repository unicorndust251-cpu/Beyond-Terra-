{
  "name": "beyond-terra",
  "private": true,
  "version": "0.1.0",
  "description": "BEYOND TERRA: a cinematic astronaut-to-website 3D introduction for a NASA-data Mars exploration platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "preview": "vite preview",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
